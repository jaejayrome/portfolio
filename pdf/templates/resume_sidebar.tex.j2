\documentclass[10pt, letterpaper]{article}

% Packages
% Sidebar content lives in \marginpar (core LaTeX, no extra package needed).
% Unlike a minipage, the main column here is normal flowing text, so it
% page-breaks correctly no matter how long the Experience section gets.
\usepackage[
  left=2.3in, right=0.45in, top=0.4in, bottom=0.4in,
  marginparwidth=1.85in, marginparsep=0.15in
]{geometry}
\usepackage[hidelinks]{hyperref}
\usepackage{xcolor}

\definecolor{accent}{HTML}{2C3E50}

\reversemarginpar % put \marginpar notes on the left, beside the main column

% Formatting
\pagestyle{empty} % No page numbers
\setlength{\parindent}{0pt}

% Section heading used in the main column
\renewcommand{\section}[1]{ %
  \vspace{6pt}%
  \noindent{\color{accent}\Large\bfseries\MakeUppercase{#1}}\\[-6pt]
  \noindent{\color{accent}\rule{\linewidth}{1pt}}\\[4pt]
}

% Section heading used inside the sidebar
\newcommand{\sidesection}[1]{ %
  \vspace{6pt}%
  \noindent{\color{accent}\bfseries\MakeUppercase{#1}}\\[-5pt]
  \noindent{\color{accent}\rule{\linewidth}{0.8pt}}\\[3pt]
}

% Custom Itemize (Tighter bullets, no external package needed)
\makeatletter
\renewcommand\itemize{ %
  \ifnum \@itemdepth >\thr@@\@toodeep\else
    \advance\@itemdepth\@ne
    \edef\@itemitem{labelitem\romannumeral\the\@itemdepth}%
    \expandafter\list\csname\@itemitem\endcsname{ %
      \setlength{\itemsep}{0pt}%
      \setlength{\topsep}{0pt}%
      \setlength{\parsep}{0pt}%
      \setlength{\leftmargin}{1em}}%
  \fi}
\makeatother

\begin{document}

{\color{accent}\huge\bfseries {{ name | tex_escape }}}\\[6pt]

\section{Experience}
\marginpar{ %
\raggedright
\small

\sidesection{Contact}
{% for part in contact_parts %}{{ part }}{% if not loop.last %} \\[3pt]
{% endif %}{% endfor %}

\sidesection{Education}
{% for edu in education %}
\textbf{ {{- edu.school | tex_escape -}} } \\
\textit{ {{- edu.degree | tex_escape -}} } \\
{{ edu.period | tex_escape }} \\
CGPA: {{ edu.cgpa }}
{% if edu.coursework %}
\vspace{3pt}

\textbf{Coursework:} {{ edu.coursework | join(", ") | tex_escape }}
{% endif %}
{% if edu.teaching %}
\vspace{3pt}

\textbf{Teaching Assistant:} {{ edu.teaching | join(", ") | tex_escape }}
{% endif %}
\vspace{6pt}

{% endfor %}

\sidesection{Skills}
\textbf{Languages}\\
{{ skills.programming_languages | join(", ") | tex_escape }}
\vspace{4pt}

\textbf{Backend}\\
{{ skills.backend | join(", ") | tex_escape }}
\vspace{4pt}

\textbf{Frontend}\\
{{ skills.frontend | join(", ") | tex_escape }}
\vspace{4pt}

\textbf{Infrastructure}\\
{{ skills.infrastructure | join(", ") | tex_escape }}
\vspace{4pt}

\textbf{Certifications}\\
{{ skills.certifications | join(", ") | tex_escape }}
}

{% for job in experience %}
\noindent
\textbf{ {{- job.company | tex_escape -}} } \hfill {{ job.location | tex_escape }} \\
\textit{ {{- job.role | tex_escape -}} } \hfill \textbf{ {{- job.period | tex_escape -}} }

\begin{itemize}
{% for b in job.bullets %}
  \item {{ b | format_latex }}
{% endfor %}
\end{itemize}
\vspace{4pt}

{% endfor %}

{% if awards %}
\section{Honours \& Awards}

\begin{itemize}
{% for a in awards %}
  \item {{ a | tex_escape }}
{% endfor %}
\end{itemize}
{% endif %}

\end{document}
