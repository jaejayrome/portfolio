\documentclass[10pt, letterpaper]{article}

% Packages
\usepackage[margin=0.4in]{geometry}
\usepackage[hidelinks]{hyperref}
\usepackage{tabularx}

% Formatting
\pagestyle{empty} % No page numbers
\setlength{\parindent}{0pt}

% Custom Section Heading (plain LaTeX, replaces titlesec)
\renewcommand{\section}[1]{ %
  \vspace{8pt}%
  \noindent{\large\bfseries\MakeUppercase{#1}}\\[-6pt]
  \noindent\rule{\linewidth}{0.6pt}\\[2pt]
}

% Custom Itemize (Tighter bullets, replaces enumitem's \setlist)
\makeatletter
\renewcommand\itemize{ %
  \ifnum \@itemdepth >\thr@@\@toodeep\else
    \advance\@itemdepth\@ne
    \edef\@itemitem{labelitem\romannumeral\the\@itemdepth}%
    \expandafter\list\csname\@itemitem\endcsname{ %
      \setlength{\itemsep}{0pt}%
      \setlength{\topsep}{0pt}%
      \setlength{\parsep}{0pt}%
      \setlength{\leftmargin}{1.2em}}%
  \fi}
\makeatother

\begin{document}

% =========================
% Header (Compact)
% =========================
\begin{center}
    {\huge \textbf{ {{ name | tex_escape }} }} \\ [4pt]
    \small
    {{ contact_parts | join(" \\ $|$ \\ ") }}
\end{center}

% =========================
% Education
% =========================
\section{Education}
{% for edu in education -%}
\noindent
\textbf{ {{- edu.school | tex_escape -}} }\hfill{} {{- edu.location | tex_escape -}} \\
\textit{ {{- edu.degree | tex_escape -}} }\textnormal{ | CGPA: {{ edu.cgpa }}}\hfill{} \textbf{ {{- edu.period | tex_escape -}} }

{% if edu.coursework %}
\vspace{2pt}
\textbf{Coursework:} {{ edu.coursework | join(", ") | tex_escape }}
{% endif %}

{% if edu.teaching %}
\vspace{2pt}
\textbf{Teaching Assistant:} {{ edu.teaching | join(", ") | tex_escape }}
{% endif %}
\vspace{4pt}
{% endfor %}

% =========================
% Skills
% =========================
\section{Skills}
\small
{% for group in skills %}
\textbf{ {{- group.label | tex_escape -}} :} {{ group["items"] | join(", ") | tex_escape }}{% if not loop.last %} \\{% endif %}
{% endfor %}
\vspace{4pt}

% =========================
% Experience
% =========================
\section{Experience}
{% for job in experience -%}
\noindent
\textbf{ {{- job.company | tex_escape -}} } \hfill {{ job.location | tex_escape }} \\
\textit{ {{- job.role | tex_escape -}} } \hfill \textbf{ {{- job.period | tex_escape -}} }

{% if job.bullets %}
\begin{itemize}
{% for b in job.bullets %}
  \item {{ b | format_latex }}
{% endfor %}
\end{itemize}
{% endif %}
\vspace{4pt}

{% endfor %}

{% if awards %}
% =========================
% Awards
% =========================
\section{Honours \& Awards}

\begin{itemize}
{% for a in awards %}
  \item {{ a | tex_escape }}
{% endfor %}
\end{itemize}
{% endif %}

\end{document}
